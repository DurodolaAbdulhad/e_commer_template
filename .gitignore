# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Client secrets — NEVER commit these (contain API keys, passwords)
.env.clients/

# Vercel client project links (local only — restored by switch-client)
.vercel-clients/
.vercel/

# Active client state (local only)
.active-client

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
